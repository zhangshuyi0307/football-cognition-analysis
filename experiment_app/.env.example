# Required to enable the supervisor unlock and abandon endpoints.
# Use a long, unique value in production. Do not commit the real value.
ADMIN_UNLOCK_CODE=replace-with-a-long-random-secret

# Optional server settings.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
HTTPS_PORT=3443
MAX_JSON_BYTES=20971520
MAX_BINARY_BYTES=104857600

# Optional: keep mutable participant data outside the application directory.
ALLOC_FILE=/var/lib/football-cognition/allocations.json
SAVE_DIR=/var/lib/football-cognition/data_server_backup
